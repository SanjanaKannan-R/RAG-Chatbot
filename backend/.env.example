# Database Configuration
DATABASE_PATH=rag.db

# Embedding Provider Configuration
# Options: 'sentence-transformers' (default, local & free), 'openai', 'local' (deterministic fallback)
EMBEDDING_PROVIDER=local

# LLM Provider Configuration
# Options: 'openai' (supports OpenAI and Groq via OPENAI_BASE_URL), 'anthropic', 'ollama', 'rule'
LLM_PROVIDER=openai

# OpenAI / Groq / OpenAI-compatible Settings
# For Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b (or openai/gpt-oss-20b)
# OPENAI_API_KEY=gsk_...
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Anthropic Settings (if using Anthropic for generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama Settings (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
